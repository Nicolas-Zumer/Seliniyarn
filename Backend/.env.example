# MongoDB Atlas: cadena de conexión de la base de datos
DB_URL=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base_de_datos>

# Secreto largo y único para firmar los JWT
JWT_SECRET=<genera-un-secreto-aleatorio>

# Cloudinary: credenciales del servicio de imágenes
CLOUDINARY_cloud_name=<cloud-name>
CLOUDINARY_api_key=<api-key>
CLOUDINARY_api_secret=<api-secret>

# Frontend permitido por CORS. En Render, sustituir por el dominio público.
FRONTEND_URL=http://localhost:5173

# Render define PORT automáticamente; solo se necesita localmente si se cambia el puerto.
# PORT=3000
